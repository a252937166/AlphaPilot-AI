            "real_registered_paths_untouched": {
              "const": true
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "//"
          },
          {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          },
          {
            "pattern": "/$"
          }
        ]
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "creating_commit",
        "unique_a_history_verified"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "creating_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "unique_a_history_verified": {
          "const": true
        }
      }
    },
    "attemptOutcomeAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "outcome",
        "implementation_epoch",
        "record_root_sha256"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "FAILED",
            "INCOMPLETE_UNTERMINALIZED",
            "CANDIDATE_VALIDATED_AND_SELECTED"
          ]
        },
        "implementation_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "record_root_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "implementationEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "implementation_commit",
        "owner_surface_authorization",
        "independent_implementation_review",
        "control_merkle_root_sha256",
        "first_attempt_ordinal",
        "last_attempt_ordinal"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "implementation_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "owner_surface_authorization": {
          "$ref": "#/$defs/authorityRef"
        },
        "independent_implementation_review": {
          "$ref": "#/$defs/authorityRef"
        },
        "control_merkle_root_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "first_attempt_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "last_attempt_ordinal": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
