  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "//"},
          {"pattern": "(^|/)\\.{1,2}(/|$)"},
          {"pattern": "/$"}
        ]
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "source_relative_path", "bytes", "sha256"],
      "properties": {
        "logical_name": {"type": "string", "minLength": 1},
        "source_relative_path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactList": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "prefixItems": [
