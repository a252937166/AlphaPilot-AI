      "properties": {
        "logical_name": {"type": "string", "minLength": 1},
        "bundle_relative_path": {"$ref": "#/$defs/relativePath"},
        "source_kind": {
          "enum": [
            "python_source",
            "package_initializer",
            "frozen_control",
            "project_manifest",
            "lockfile",
            "control_manifest",
            "python_runtime",
            "package_inventory"
          ]
