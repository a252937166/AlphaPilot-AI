<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__FUTU_SERVICE_LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__FUTU_OPEND_BIN__</string>
        <string>-cfg_file=__FUTU_CONFIG_FILE__</string>
        <string>-console=0</string>
        <string>-no_monitor=1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__FUTU_LAUNCHER_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__FUTU_LAUNCHER_LOG__</string>
</dict>
</plist>
