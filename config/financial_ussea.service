[Unit]
Description=AlphaPilot S2 US-SEA BaoStock financial backfill
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/alphapilot-s2-ussea/data/alphapilot-s2.db

[Service]
Type=oneshot
User=alphapilot-s2
Group=alphapilot-s2
WorkingDirectory=/opt/alphapilot-s2-ussea/app
EnvironmentFile=/opt/alphapilot-s2-ussea/.env
ExecStart=/opt/alphapilot-s2-ussea/run-financial-backfill.sh
TimeoutStartSec=6h
Restart=no
Nice=10
IOSchedulingClass=idle
CPUQuota=40%
MemoryMax=256M
MemorySwapMax=384M
TasksMax=64
LimitNOFILE=1024
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/alphapilot-s2-ussea/app /opt/alphapilot-s2-ussea/.venv /opt/alphapilot-s2-ussea/.env
ReadWritePaths=/opt/alphapilot-s2-ussea/data /opt/alphapilot-s2-ussea/logs /opt/alphapilot-s2-ussea/exports
