<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__BACKUP_SERVICE_LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BACKUP_VENV_PYTHON__</string>
        <string>__BACKUP_PROJECT_DIR__/scripts/run_database_backup_daily.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__BACKUP_PROJECT_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>__BACKUP_STDOUT_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__BACKUP_STDERR_LOG__</string>
</dict>
</plist>
