<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__TRAIN_IC_LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__TRAIN_IC_PYTHON__</string>
        <string>-u</string>
        <string>__TRAIN_IC_SCRIPT__</string>
        <string>--start-date</string>
        <string>__TRAIN_IC_START_DATE__</string>
        <string>--end-date</string>
        <string>__TRAIN_IC_END_DATE__</string>
        <string>--train-ratio</string>
        <string>0.7</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__TRAIN_IC_WORKING_DIRECTORY__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__TRAIN_IC_STDOUT_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__TRAIN_IC_STDERR_LOG__</string>
</dict>
</plist>
