        },
        "budget_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated_model_calls",
            "estimated_cost_cny",
            "maximum_model_calls",
            "maximum_total_cost_cny",
            "currency",
            "basis_refs"
          ],
          "properties": {
            "estimated_model_calls": {
              "type": "integer",
              "minimum": 1
            },
            "estimated_cost_cny": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximum_model_calls": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_total_cost_cny": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "const": "CNY"
            },
            "basis_refs": {
              "$ref": "#/$defs/fileRefs"
            }
          }
        }
      },
      "description": "A separate future owner decision binds real preparation calls and cost. Estimates are not execution ceilings; the admission module cross-checks both ceilings against execution_limits and the actual registered plan."
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amend_or_overwrite_existing_evidence",
        "automatic_retries",
        "new_attempt_requires_separate_explicit_authority",
        "on_any_natural_failure",
        "repair_or_retry_in_same_consumed_stage"
      ],
      "properties": {
        "amend_or_overwrite_existing_evidence": {
          "const": false
        },
        "automatic_retries": {
          "const": 0
        },
        "new_attempt_requires_separate_explicit_authority": {
          "const": true
        },
        "on_any_natural_failure": {
          "const": "PRESERVE_ORIGINAL_EVIDENCE_AND_STOP_FOR_INDEPENDENT_REVIEW"
        },
        "repair_or_retry_in_same_consumed_stage": {
          "const": false
        }
      }
    },
    "supporting_evidence_manifest": {
      "$ref": "#/$defs/externalFileRef"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f]+$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)/[^\\\\:\\u0000-\\u001f]+$"
    },
    "localPath": {
      "oneOf": [
        {
          "$ref": "#/$defs/repoRelativePath"
        },
        {
          "$ref": "#/$defs/absolutePath"
        }
      ]
    },
    "utcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$"
    },
    "shanghaiTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "\\+08:00$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/localPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "externalFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fileRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "externalVerbatimSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "source_bytes",
        "verbatim_text",
        "relay_path",
        "relay_sha256",
        "observed_at_utc",
        "delivery_channel"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "verbatim_text": {
          "type": "string",
          "minLength": 1
        },
        "relay_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "relay_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at_utc": {
          "$ref": "#/$defs/utcTime"
        },
        "delivery_channel": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "The owner supplies verbatim_text. UTF-8 source bytes and relay are verified independently by the admission module; this schema does not create or attest an owner decision."
    },
    "reviewAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "reviewer_type",
        "model",
        "method",
        "independent_of_operator",
        "observed_at_utc",
        "evidence_refs"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_type": {
          "enum": [
            "human",
            "ai"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "independent_of_operator": {
          "const": true
        },
        "observed_at_utc": {
          "$ref": "#/$defs/utcTime"
        },
        "evidence_refs": {
          "$ref": "#/$defs/fileRefs"
        }
      },
      "description": "An actual independent reviewer supplies these fields. Hash and Git bindings do not substitute for an independent review or introduce a cryptographic-signature requirement."
    },
    "naturalCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "command_ref",
        "rc",
        "stdout_sha256",
        "stderr_sha256",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "check_id": {
          "enum": [
            "old_gate_regression",
            "new_gate_fail_closed",
            "historical_h0_integrity",
            "current_source_closure",
            "five_preparation_entries",
            "science_and_retry_invariants",
            "manifest_version_binding",
            "finalize_evaluate_locks",
            "git_lineage_ref_drift",
            "independent_review_requirement"
          ]
        },
        "command_ref": {
          "$ref": "#/$defs/externalFileRef"
        },
        "rc": {
          "const": 0
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "PASS"
        },
        "evidence_refs": {
          "$ref": "#/$defs/fileRefs"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter_realpath",
        "interpreter_sha256",
        "python_version",
        "packages",
        "packages_sha256"
      ],
      "properties": {
        "interpreter_realpath": {
          "$ref": "#/$defs/absolutePath"
        },
        "interpreter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "packages_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
