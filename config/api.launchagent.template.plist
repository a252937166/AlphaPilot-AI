<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__API_SERVICE_LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__API_VENV_PYTHON__</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>alphapilot.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__API_WORKING_DIRECTORY__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ALPHAPILOT_SCHEDULER_ENABLED</key>
        <string>false</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__API_STDOUT_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__API_STDERR_LOG__</string>
</dict>
</plist>
