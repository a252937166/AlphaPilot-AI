ALPHAPILOT_APP_ENV=backfill
ALPHAPILOT_DATABASE_URL=sqlite:////opt/alphapilot-s2-ussea/data/alphapilot-s2.db
ALPHAPILOT_DEFAULT_DATA_PROVIDER=baostock
ALPHAPILOT_SCHEDULER_ENABLED=false
ALPHAPILOT_MARKET_POLL_ENABLED=false
ALPHAPILOT_BAOSTOCK_FINANCIAL_SYNC_ENABLED=false
ALPHAPILOT_VALUATION_SYNC_ENABLED=false
ALPHAPILOT_FUTU_ENABLE_QUOTE=false
ALPHAPILOT_FUTU_ENABLE_TRADE_QUERY=false
ALPHAPILOT_FUTU_ENABLE_ACCOUNT_MUTATION=false
ALPHAPILOT_FUTU_ENABLE_TRADE=false
ALPHAPILOT_TRADING_MODE=research
ALPHAPILOT_LIVE_TRADING_ENABLED=false
ALPHAPILOT_PAPER_TRADING_ENABLED=false
ALPHAPILOT_PAPER_AUTO_TRADING_ENABLED=false
ALPHAPILOT_TRADING_HALTED=true
ALPHAPILOT_BAOSTOCK_LOCK_FILE=/opt/alphapilot-s2-ussea/data/baostock-host.lock
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
