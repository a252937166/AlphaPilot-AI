# Application
ALPHAPILOT_APP_ENV=development
ALPHAPILOT_LOG_LEVEL=INFO
# auto = failover chain (bars: baostock -> akshare -> futu; snapshot: futu -> akshare).
# Other values: mock / akshare / baostock / futu
ALPHAPILOT_DEFAULT_DATA_PROVIDER=auto
ALPHAPILOT_API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage. SQLite works out of the box; switch to PostgreSQL when running compose:
# ALPHAPILOT_DATABASE_URL=postgresql+psycopg://alphapilot:alphapilot@127.0.0.1:5432/alphapilot
ALPHAPILOT_DATABASE_URL=sqlite:///data/alphapilot.db
ALPHAPILOT_REDIS_URL=redis://127.0.0.1:6379/0

# In-process job scheduler. Keep disabled in tests and opt in explicitly per environment.
ALPHAPILOT_SCHEDULER_ENABLED=false
ALPHAPILOT_MARKET_POLL_ENABLED=false

# Provider failover chains for the "auto" provider (comma separated).
ALPHAPILOT_DAILY_BARS_PROVIDER_CHAIN=baostock,akshare,futu
ALPHAPILOT_SNAPSHOT_PROVIDER_CHAIN=futu,akshare
ALPHAPILOT_FACTOR_WEIGHTS_FILE=config/factor_weights.yaml
# BaoStock transport and in-process lock deadlines. EOF/timeout invalidates the
# shared session so the auto provider can fail over instead of exhausting workers.
ALPHAPILOT_BAOSTOCK_SOCKET_TIMEOUT_SECONDS=2
ALPHAPILOT_BAOSTOCK_LOCK_TIMEOUT_SECONDS=1

# Tushare Pro token for point-in-time backtest data such as adj_factor.
# Keep the real value only in the local gitignored .env.
ALPHAPILOT_TUSHARE_TOKEN=

# cninfo / 深证信 WebAPI credentials. Fill locally only — .env is gitignored and
# these values must never be committed, logged or sent to the frontend.
ALPHAPILOT_CNINFO_ACCESS_KEY=
ALPHAPILOT_CNINFO_ACCESS_SECRET=

# Futu OpenD quote connection
ALPHAPILOT_FUTU_HOST=127.0.0.1
ALPHAPILOT_FUTU_PORT=11111
ALPHAPILOT_FUTU_ENABLE_QUOTE=true
ALPHAPILOT_FUTU_SECURITY_FIRM=FUTUSECURITIES

# Read-only account queries and watchlist/reminder changes are separate opt-ins.
ALPHAPILOT_FUTU_ENABLE_TRADE_QUERY=false
ALPHAPILOT_FUTU_ENABLE_ACCOUNT_MUTATION=false

# Trading is deliberately disabled by default.
ALPHAPILOT_FUTU_ENABLE_TRADE=false
ALPHAPILOT_LIVE_TRADING_ENABLED=false
ALPHAPILOT_TRADING_MODE=research
ALPHAPILOT_PAPER_TRADING_ENABLED=false
# Guarded SIMULATE automation is a separate opt-in and additionally requires
# TRADING_MODE=paper_auto, trade query/write switches, fresh audited signals,
# live-trading=false and every execution-time risk check.
ALPHAPILOT_PAPER_AUTO_TRADING_ENABLED=false
ALPHAPILOT_PAPER_AUTO_MAX_ORDERS_PER_DAY=3
ALPHAPILOT_PAPER_AUTO_MAX_ORDER_NOTIONAL_PCT=0.02
# Initial Kill Switch value; P2.3-S6 will persist the runtime override in the database.
ALPHAPILOT_TRADING_HALTED=false
# Research fallback equity only; never substitutes for a live simulated-account query.
ALPHAPILOT_DEMO_EQUITY=1000000.0

# Hard risk limits
ALPHAPILOT_MIN_TRADE_CONFIDENCE=0.68
ALPHAPILOT_MAX_SINGLE_POSITION_PCT=0.10
ALPHAPILOT_MAX_SECTOR_POSITION_PCT=0.30
ALPHAPILOT_MAX_DAILY_LOSS_PCT=0.02
ALPHAPILOT_MAX_MARKET_DATA_AGE_SECONDS=120

# Optional MiroFish finance bridge. The original project needs a finance-specific adapter.
ALPHAPILOT_MIROFISH_BASE_URL=
ALPHAPILOT_MIROFISH_API_KEY=

# Optional LLM used for report/overview commentary. Never put secrets in Git.
ALPHAPILOT_LLM_BASE_URL=
ALPHAPILOT_LLM_API_KEY=
ALPHAPILOT_LLM_MODEL=qwen3.6-flash
# Optional JSON mapping. Unlisted purposes keep ALPHAPILOT_LLM_MODEL.
# Example: {"stock_insight":"qwen3.7-plus"}
ALPHAPILOT_LLM_PURPOSE_MODELS={}
# Optional wording polish for the rule-generated intraday monitor feed.
# The model may change text only; facts, ordering, timestamps, and levels stay rule-bound.
ALPHAPILOT_LLM_POLISH_FEED=false
